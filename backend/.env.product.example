# Copy the required values into backend/.env. Never commit credentials.
APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pre-Consultation <hello@your-verified-domain.com>
# Any email can register a doctor account; each email has one permanent role.
# Defaults are persistent local SQLite and private uploads under backend/data/.
# PRODUCT_DB_PATH=/absolute/persistent/path/product.sqlite3
# UPLOAD_DIR=/absolute/persistent/path/uploads
# For public HTTPS deployment:
# APP_ENV=production
# APP_BASE_URL=https://preconsult.example.com
# FRONTEND_ORIGIN=https://preconsult.example.com
