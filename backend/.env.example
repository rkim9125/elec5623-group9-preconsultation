# Copy to .env and fill in values. Do not commit .env.

# App
APP_ENV=
API_HOST=
API_PORT=

# Database
DATABASE_URL=sqlite:///./preconsult.db

# LLM provider
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# CORS — leave EMPTY for local development. Empty means "allow any
# localhost/127.0.0.1 port", which is what the Vite dev server needs.
# Set it (comma-separated) only for a deployed frontend, e.g.
# FRONTEND_ORIGIN=https://example.com
FRONTEND_ORIGIN=
