# Copy to .env and fill in values. Do not commit .env.

# App
APP_ENV=
API_HOST=
API_PORT=

# Database
DATABASE_URL=sqlite:///./preconsult.db

# LLM provider
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# CORS — leave EMPTY for local development. Empty means "allow any
# localhost/127.0.0.1 port", which is what the Vite dev server needs.
# Set it (comma-separated) only for a deployed frontend, e.g.
# FRONTEND_ORIGIN=https://example.com
FRONTEND_ORIGIN=

# Model pricing for cost reporting (GET /api/v1/usage). USD per 1,000,000
# tokens, taken from the provider's pricing page — nothing in the code guesses
# these. A model with no entry reports its token counts with a null cost
# instead of a made-up number.
# MODEL_PRICES_USD={"gpt-6-sol": {"input": 1.25, "output": 10.00}}
