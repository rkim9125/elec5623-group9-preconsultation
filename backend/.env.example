# Copy to backend/.env; never commit real credentials. Defaults run offline.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Reserved until C6 and C4 are integrated. Currently in-memory + FakeLLM.
DATABASE_URL=sqlite:///./preconsult.db
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# C5: local | s3 | oss. Relative paths resolve from backend/.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.data/objects
STORAGE_PREFIX=c5
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_OSS_IS_CNAME=false
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_SESSION_TOKEN=
STORAGE_TIMEOUT_SECONDS=10
# Optional for loopback local demo; REQUIRED when using cloud storage.
# Shared server integration token, not patient/tenant authentication.
DOCUMENT_API_TOKEN=
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PDF_PAGES=50
DOCUMENT_MAX_TEXT_CHARS=200000
DOCUMENT_MAX_IMAGE_PIXELS=20000000
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_TIMEOUT_SECONDS=20
# Optional installed TTF with glyphs beyond built-in Latin/GB2312 CJK.
# C5_PDF_FONT_PATH=/absolute/path/to/font.ttf
